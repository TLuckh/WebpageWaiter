<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
            Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{0B861F95-8DAB-4504-9768-15E60559E591}</ProjectGuid>
        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>WebpageWaiter</RootNamespace>
        <AssemblyName>WebpageWaiter</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <FileAlignment>512</FileAlignment>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    
    

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Accessibility" />

        <Reference Include="FlaUI.Core, Version=5.0.0.0, Culture=neutral, processorArchitecture=MSIL">
            <HintPath>..\packages\FlaUI.Core.5.0.0\lib\net48\FlaUI.Core.dll</HintPath>
        </Reference>

        <Reference Include="FlaUI.UIA3, Version=5.0.0.0, Culture=neutral, processorArchitecture=MSIL">
            <HintPath>..\packages\FlaUI.UIA3.5.0.0\lib\net48\FlaUI.UIA3.dll</HintPath>
        </Reference>

        <Reference Include="Interop.UIAutomationClient, Version=10.0.19041.0, Culture=neutral, processorArchitecture=MSIL">
            <HintPath>..\packages\Interop.UIAutomationClient.10.19041.0\lib\net45\Interop.UIAutomationClient.dll</HintPath>
        </Reference>

        <Reference Include="PresentationCore" />
        <Reference Include="PresentationFramework" />
        <Reference Include="System" />

        <Reference Include="System.CodeDom, Version=8.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51, processorArchitecture=MSIL">
            <HintPath>..\packages\System.CodeDom.8.0.0\lib\net462\System.CodeDom.dll</HintPath>
        </Reference>

        <Reference Include="System.Core" />
        <Reference Include="System.Data" />
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.Management" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Windows.Forms" />
        <Reference Include="System.Xml" />
        <Reference Include="WindowsBase" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="CSequence.cs" />
        <Compile Include="DataStructures.cs" />
        <Compile Include="WebpageWaiterExt.cs" />
        <Compile Include="Properties\AssemblyInfo.cs" />
        <Compile Include="WebAutoType\AccessibleObjectHelper.cs" />
        <Compile Include="WebAutoType\BrowserUrlReader.cs" />
        <Compile Include="WebAutoType\ChromeAccessibilityWinEventHook.cs" />
        <Compile Include="WebAutoType\ChromeBrowserUrlReader.cs" />
        <Compile Include="WebAutoType\EdgeBrowserUrlReader.cs" />
        <Compile Include="WebAutoType\FirefoxBrowserUrlReader.cs" />
        <Compile Include="WebAutoType\InternetExplorerBrowserUrlReader.cs" />
        <Compile Include="WebAutoType\WebBrowserUrl.cs" />
    </ItemGroup>

    <!-- BrowserLoadingDetector wird in Debug normal kopiert
         und in Release von Costura eingebettet. -->
    <ItemGroup>
        <ProjectReference Include="..\BrowserLoadingDetector\BrowserLoadingDetector.csproj">
            <Project>{bd1d72d7-befe-bbbc-bdb8-355d9c62517c}</Project>
            <Name>BrowserLoadingDetector</Name>
        </ProjectReference>
    </ItemGroup>

    <!-- Debug: gegen das KeePass-Projekt bauen -->
    <ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
        <ProjectReference Include="..\KeePass\KeePass\KeePass_N48.csproj">
            <Project>{10938016-dee2-4a25-9a5a-8fd3444379ca}</Project>
            <Name>KeePass_N48</Name>
        </ProjectReference>
    </ItemGroup>

    <!-- Release: gegen die signierte KeePass.exe bauen.
         Costura-Referenz nur in Release. -->
    <ItemGroup Condition=" '$(Configuration)' == 'Release' ">
        <Reference Include="Costura, Version=6.2.0.0, Culture=neutral, PublicKeyToken=9919ef960d84173d, processorArchitecture=MSIL">
            <HintPath>..\packages\Costura.Fody.6.2.0\lib\netstandard2.0\Costura.dll</HintPath>
        </Reference>
        <Reference Include="KeePass">
            <HintPath>..\Resources\KeePass.exe</HintPath>
        </Reference>
        <ContentWithTargetPath Include="..\Resources\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
        </ContentWithTargetPath>
    </ItemGroup>

    <!-- Make a zip out of the files relevant to be uploaded -->
    <Target Name="CreateWebWaiterZip"
            AfterTargets="Build"
            Condition="'$(Configuration)' == 'Release'">

        <PropertyGroup>
            <WebWaiterZipPath>$(TargetDir)WebWaiter.zip</WebWaiterZipPath>
        </PropertyGroup>

        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -LiteralPath '$(TargetPath)' -DestinationPath '$(WebWaiterZipPath)' -Force&quot;" />
    </Target>

    <ItemGroup>
        <None Include="App.config" />
        <None Include="packages.config" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="#ToDos.md" />
      <Content Include="README.md" />
    </ItemGroup>

    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

    <Import Project="..\packages\Interop.UIAutomationClient.10.19041.0\build\Interop.UIAutomationClient.targets"
            Condition="Exists('..\packages\Interop.UIAutomationClient.10.19041.0\build\Interop.UIAutomationClient.targets')" />

    <!-- Costura nur in Release importieren -->
    <Import Project="..\packages\Costura.Fody.6.2.0\build\Costura.Fody.props"
            Condition="'$(Configuration)' == 'Release' And Exists('..\packages\Costura.Fody.6.2.0\build\Costura.Fody.props')" />

    <Import Project="..\packages\Costura.Fody.6.2.0\build\Costura.Fody.targets"
            Condition="'$(Configuration)' == 'Release' And Exists('..\packages\Costura.Fody.6.2.0\build\Costura.Fody.targets')" />

    <!-- Fody ist der eigentliche Weaver und darf deshalb ebenfalls
         ausschließlich in Release importiert werden. -->
    <Import Project="..\packages\Fody.6.9.3\build\Fody.targets"
            Condition="'$(Configuration)' == 'Release' And Exists('..\packages\Fody.6.9.3\build\Fody.targets')" />

    <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
        <PropertyGroup>
            <ErrorText>
                This project references NuGet package(s) that are missing on this computer.
                Enable NuGet Package Restore to download them.
                For more information, see http://go.microsoft.com/fwlink/?LinkID=322105.
                The missing file is {0}.
            </ErrorText>
        </PropertyGroup>

        <Error Condition="!Exists('..\packages\Interop.UIAutomationClient.10.19041.0\build\Interop.UIAutomationClient.targets')"
               Text="$([System.String]::Format('$(ErrorText)', '..\packages\Interop.UIAutomationClient.10.19041.0\build\Interop.UIAutomationClient.targets'))" />

        <!-- Fody / Costura werden nur für Release benötigt -->
        <Error Condition="'$(Configuration)' == 'Release' And !Exists('..\packages\Fody.6.9.3\build\Fody.targets')"
               Text="$([System.String]::Format('$(ErrorText)', '..\packages\Fody.6.9.3\build\Fody.targets'))" />

        <Error Condition="'$(Configuration)' == 'Release' And !Exists('..\packages\Costura.Fody.6.2.0\build\Costura.Fody.props')"
               Text="$([System.String]::Format('$(ErrorText)', '..\packages\Costura.Fody.6.2.0\build\Costura.Fody.props'))" />

        <Error Condition="'$(Configuration)' == 'Release' And !Exists('..\packages\Costura.Fody.6.2.0\build\Costura.Fody.targets')"
               Text="$([System.String]::Format('$(ErrorText)', '..\packages\Costura.Fody.6.2.0\build\Costura.Fody.targets'))" />
    </Target>

</Project>